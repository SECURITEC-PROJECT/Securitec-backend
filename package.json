{
  "name": "securitec-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
