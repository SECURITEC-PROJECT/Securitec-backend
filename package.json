    "db:seed": "node --no-warnings scripts/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "^7.4.1"
  }
}
