{
  "name": "securitec-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --config=prisma.migrate.config.ts",
    "db:deploy": "prisma migrate deploy --config=prisma.migrate.config.ts",
    "db:seed": "node prisma/seeds/run.js",
    "db:check": "node scripts/checkDatabase.js",
    "db:studio": "prisma studio --config=prisma.studio.config.ts",
    "db:create-user": "node scripts/createUser.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "7.4.1",
    "bcryptjs": "3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "7.4.1"
  }
}
