# Neon > Connect > Pooled connection (utilisée par l'application)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon > Connect > Direct connection (utilisée par Prisma Migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=5000
# Origines autorisées à appeler l'API, séparées par des virgules (origine exacte, sans chemin).
CORS_ORIGINS=http://localhost:5173

# Secret de signature des sessions : au moins 32 caractères aléatoires.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
