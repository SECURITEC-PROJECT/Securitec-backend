# Application runtime: Neon > Connect > Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma Migrate: Neon > Connect > Direct connection
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"
# A separate Neon database or branch reserved for Prisma's shadow database
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb_shadow?sslmode=require"

PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
