generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                    String                   @db.VarChar(255)
  identifiant            String                   @unique @db.VarChar(100)
  role                   Int
  pinHache               String                   @map("pin_hache") @db.VarChar(255)
  siteId                 String?                  @map("site_id") @db.Uuid
  audits                 AuditCompteRendu[]
  badges                 Badge[]
  consignes              Consigne[]
  controle_alcoolemie    controle_alcoolemie[]
  flux_logistique        flux_logistique[]
  passation              passation[]
  ronde                  ronde?
  signalement_logistique signalement_logistique[]
  suivi_cle              suivi_cle[]
  site                   site?                    @relation(fields: [siteId], references: [id], map: "fk_utilisateur_site")
  vacations              Vacation[]

  @@index([siteId], map: "idx_utilisateur_site")
  @@map("utilisateur")
}

model Consigne {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message       String
  cible         String      @db.VarChar(255)
  urgence       Int
  validite      DateTime    @db.Timestamp(6)
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade, map: "fk_consigne_utilisateur")

  @@index([utilisateurId], map: "idx_consigne_utilisateur")
  @@map("consigne")
}

model Badge {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uidNfc        String         @unique @map("uid_nfc") @db.VarChar(255)
  couleur       String?        @db.VarChar(50)
  statut        Int
  validite      DateTime       @db.Timestamp(6)
  utilisateurId String?        @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur?   @relation(fields: [utilisateurId], references: [id], map: "fk_badge_utilisateur")
  lectures      LectureBadge[]
  passages      Passage[]
  visiteur      Visiteur?

  @@index([utilisateurId], map: "idx_badge_utilisateur")
  @@map("badge")
}

model Visiteur {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identite   String    @db.VarChar(255)
  societe    String?   @db.VarChar(255)
  listeNoire Boolean   @default(false) @map("liste_noire")
  siteId     String?   @map("site_id") @db.Uuid
  badgeId    String?   @unique @map("badge_id") @db.Uuid
  passages   Passage[]
  badge      Badge?    @relation(fields: [badgeId], references: [id], map: "fk_visiteur_badge")
  site       site?     @relation(fields: [siteId], references: [id], map: "fk_visiteur_site")

  @@index([siteId], map: "idx_visiteur_site")
  @@map("visiteur")
}

model Passage {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entree          DateTime  @db.Timestamp(6)
  sortie          DateTime? @db.Timestamp(6)
  motif           String?
  badgeId         String    @map("badge_id") @db.Uuid
  visiteurId      String?   @map("visiteur_id") @db.Uuid
  type_piece      String?   @db.VarChar(80)
  piece_fin       String?   @db.VarChar(4)
  hote            String?   @db.VarChar(255)
  zone            String?   @db.VarChar(255)
  materiel        String?
  immatriculation String?   @db.VarChar(50)
  notes_sortie    String?
  badge_numero    String?   @db.VarChar(80)
  saisi_par_id    String?   @db.Uuid
  sortie_par_id   String?   @db.Uuid
  badge           Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade, map: "fk_passage_badge")
  visiteur        Visiteur? @relation(fields: [visiteurId], references: [id], map: "fk_passage_visiteur")

  @@index([badgeId], map: "idx_passage_badge")
  @@index([visiteurId, sortie], map: "idx_passage_site_presence")
  @@map("passage")
}

model Vacation {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ouverture        DateTime          @db.Timestamp(6)
  cloture          DateTime?         @db.Timestamp(6)
  passation        String?
  utilisateurId    String            @map("utilisateur_id") @db.Uuid
  agent_nom        String?           @db.VarChar(255)
  matricule        String?           @db.VarChar(50)
  prestataire_nom  String?           @db.VarChar(160)
  site_id          String?           @db.Uuid
  poste_nom        String?           @db.VarChar(160)
  shift_type       ShiftAgent?
  checklist        Json              @default("{}")
  observations     String?
  compteRendu      CompteRendu?
  evenements       Evenement[]
  passagesVehicule PassageVehicule[]
  passations       passation[]
  site             site?             @relation(fields: [site_id], references: [id], map: "fk_vacation_site")
  utilisateur      Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade, map: "fk_vacation_utilisateur")

  @@index([utilisateurId], map: "idx_vacation_utilisateur")
  @@map("vacation")
}

model CompteRendu {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observations     String?
  signature        String?            @db.VarChar(255)
  pdf              String?
  statutValidation String             @map("statut_validation") @db.VarChar(100)
  vacationId       String             @unique @map("vacation_id") @db.Uuid
  siteId           String             @map("site_id") @db.Uuid
  prestataireId    String             @map("prestataire_id") @db.Uuid
  posteId          String             @map("poste_id") @db.Uuid
  dateRapport      DateTime           @map("date_rapport") @db.Date
  debutService     DateTime           @map("debut_service") @db.Time(0)
  finService       DateTime           @map("fin_service") @db.Time(0)
  details          Json               @default("{}")
  audit            AuditCompteRendu[]
  poste            Poste              @relation(fields: [posteId], references: [id], map: "fk_compterendu_poste")
  prestataire      Prestataire        @relation(fields: [prestataireId], references: [id], map: "fk_compterendu_prestataire")
  site             site               @relation(fields: [siteId], references: [id], map: "fk_compterendu_site")
  vacation         Vacation           @relation(fields: [vacationId], references: [id], onDelete: Cascade, map: "fk_compterendu_vacation")
  agents           CompteRenduAgent[]
  evenements       Evenement[]

  @@unique([siteId, dateRapport], map: "uq_compte_rendu_site_date")
  @@map("compte_rendu")
}

model Evenement {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String       @db.VarChar(100)
  gravite       Int
  description   String?
  lienOrigine   String?      @map("lien_origine") @db.VarChar(255)
  vacationId    String       @map("vacation_id") @db.Uuid
  compteRenduId String?      @map("compte_rendu_id") @db.Uuid
  compteRendu   CompteRendu? @relation(fields: [compteRenduId], references: [id], map: "fk_evenement_compte_rendu")
  vacation      Vacation     @relation(fields: [vacationId], references: [id], onDelete: Cascade, map: "fk_evenement_vacation")

  @@index([vacationId], map: "idx_evenement_vacation")
  @@map("evenement")
}

model Zone {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom               String    @db.VarChar(255)
  niveauAccesRequis Int       @map("niveau_acces_requis")
  siteId            String    @map("site_id") @db.Uuid
  cameras           Camera[]
  lecteurs          Lecteur[]
  site              site      @relation(fields: [siteId], references: [id], onDelete: Cascade, map: "fk_zone_site")

  @@index([siteId], map: "idx_zone_site")
  @@map("zone")
}

model Lecteur {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uidNfc      String         @unique @map("uid_nfc") @db.VarChar(255)
  emplacement String         @db.VarChar(255)
  zoneId      String         @map("zone_id") @db.Uuid
  zone        Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade, map: "fk_lecteur_zone")
  lectures    LectureBadge[]

  @@index([zoneId], map: "idx_lecteur_zone")
  @@map("lecteur")
}

model LectureBadge {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  horodatage DateTime @db.Timestamp(6)
  decision   String   @db.VarChar(100)
  autoriser  Boolean
  badgeId    String   @map("badge_id") @db.Uuid
  lecteurId  String   @map("lecteur_id") @db.Uuid
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade, map: "fk_lecture_badge")
  lecteur    Lecteur  @relation(fields: [lecteurId], references: [id], onDelete: Cascade, map: "fk_lecture_lecteur")

  @@index([badgeId], map: "idx_lecture_badge_badge")
  @@index([lecteurId], map: "idx_lecture_badge_lecteur")
  @@map("lecture_badge")
}

model Camera {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom     String @db.VarChar(255)
  urlFlux String @map("url_flux")
  etat    String @db.VarChar(100)
  zoneId  String @map("zone_id") @db.Uuid
  zone    Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade, map: "fk_camera_zone")

  @@index([zoneId], map: "idx_camera_zone")
  @@map("camera")
}

model Vehicule {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  immatriculation String           @unique @db.VarChar(50)
  type            String           @db.VarChar(100)
  listeNoire      Boolean          @default(false) @map("liste_noire")
  passages        PassageVehicule?

  @@map("vehicule")
}

model PassageVehicule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entree            DateTime  @db.Timestamp(6)
  sortie            DateTime? @db.Timestamp(6)
  photos            String?
  vehiculeId        String    @unique(map: "uq_passagevehicule_open_vehicle", where: raw("(sortie IS NULL)")) @map("vehicule_id") @db.Uuid
  vacationId        String?   @map("vacation_id") @db.Uuid
  transporteur      String?   @db.VarChar(255)
  conducteur        String?   @db.VarChar(255)
  passagers         String?   @db.VarChar(255)
  motif             String?
  zone              String?   @db.VarChar(255)
  operation         String?   @db.VarChar(40)
  reference         String?   @db.VarChar(100)
  plomb             String?   @db.VarChar(100)
  etat_chargement   String?   @db.VarChar(40)
  controle_conforme Boolean   @default(false)
  saisi_par_id      String?   @db.Uuid
  sortie_par_id     String?   @db.Uuid
  site_id           String?   @db.Uuid
  site              site?     @relation(fields: [site_id], references: [id], map: "fk_passagevehicule_site")
  vacation          Vacation? @relation(fields: [vacationId], references: [id], map: "fk_passagevehicule_vacation")
  vehicule          Vehicule  @relation(fields: [vehiculeId], references: [id], onDelete: Cascade, map: "fk_passagevehicule_vehicule")

  @@index([vehiculeId], map: "idx_passage_vehicule_vehicule")
  @@index([site_id, entree], map: "idx_passagevehicule_site_date")
  @@map("passage_vehicule")
}

model Prestataire {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom           String        @unique @db.VarChar(160)
  actif         Boolean       @default(true)
  agents        Agent[]
  comptesRendus CompteRendu[]

  @@map("prestataire")
}

model Poste {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom           String             @db.VarChar(160)
  actif         Boolean            @default(true)
  siteId        String             @map("site_id") @db.Uuid
  comptesRendus CompteRendu[]
  agents        CompteRenduAgent[]
  site          site               @relation(fields: [siteId], references: [id], onDelete: Cascade, map: "fk_poste_site")

  @@unique([siteId, nom], map: "uq_poste_site_nom")
  @@map("poste")
}

model Agent {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prenom        String             @db.VarChar(100)
  nom           String             @db.VarChar(100)
  matricule     String             @unique @db.VarChar(50)
  actif         Boolean            @default(true)
  prestataireId String             @map("prestataire_id") @db.Uuid
  prestataire   Prestataire        @relation(fields: [prestataireId], references: [id], map: "fk_agent_prestataire")
  comptesRendus CompteRenduAgent[]

  @@map("agent")
}

model CompteRenduAgent {
  compteRenduId String      @map("compte_rendu_id") @db.Uuid
  agentId       String      @map("agent_id") @db.Uuid
  posteId       String      @map("poste_id") @db.Uuid
  shift         ShiftAgent
  agent         Agent       @relation(fields: [agentId], references: [id], map: "fk_cr_agent_agent")
  compteRendu   CompteRendu @relation(fields: [compteRenduId], references: [id], onDelete: Cascade, map: "fk_cr_agent_compte_rendu")
  poste         Poste       @relation(fields: [posteId], references: [id], map: "fk_cr_agent_poste")

  @@id([compteRenduId, agentId, shift])
  @@map("compte_rendu_agent")
}

model AuditCompteRendu {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compteRenduId String      @map("compte_rendu_id") @db.Uuid
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  action        String      @db.VarChar(40)
  avant         Json?
  apres         Json
  creeLe        DateTime    @default(now()) @map("cree_le") @db.Timestamp(6)
  compteRendu   CompteRendu @relation(fields: [compteRenduId], references: [id], map: "fk_audit_cr")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], map: "fk_audit_utilisateur")

  @@index([compteRenduId, creeLe], map: "idx_audit_cr_date")
  @@map("audit_compte_rendu")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model controle_alcoolemie {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cree_le        DateTime    @default(now()) @db.Timestamp(6)
  date_controle  DateTime    @db.Date
  heure          DateTime    @db.Time(0)
  personne       String      @db.VarChar(255)
  appartenance   String      @db.VarChar(40)
  demandeur      String?     @db.VarChar(255)
  type_demande   String      @db.VarChar(80)
  resultat       String      @db.VarChar(20)
  taux_mesure    Decimal?    @db.Decimal(5, 2)
  site_id        String      @db.Uuid
  utilisateur_id String      @db.Uuid
  site           site        @relation(fields: [site_id], references: [id], map: "fk_controle_alcoolemie_site")
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [id], map: "fk_controle_alcoolemie_utilisateur")

  @@index([site_id, date_controle, heure], map: "idx_alcoolemie_site_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model flux_logistique {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cree_le         DateTime    @default(now()) @db.Timestamp(6)
  date_operation  DateTime    @db.Date
  type_flux       String      @db.VarChar(20)
  camion          String?     @db.VarChar(160)
  transporteur    String?     @db.VarChar(255)
  document        String?     @db.VarChar(160)
  plomb           String?     @db.VarChar(100)
  categorie_stock String?     @db.VarChar(40)
  article         String?     @db.VarChar(100)
  quantite        Decimal?    @db.Decimal(12, 2)
  site_id         String      @db.Uuid
  utilisateur_id  String      @db.Uuid
  site            site        @relation(fields: [site_id], references: [id], map: "fk_flux_logistique_site")
  utilisateur     Utilisateur @relation(fields: [utilisateur_id], references: [id], map: "fk_flux_logistique_utilisateur")

  @@index([site_id, date_operation, type_flux], map: "idx_flux_logistique_site_date")
}

model passation {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cree_le              DateTime    @default(now()) @db.Timestamp(6)
  sortant_nom          String      @db.VarChar(255)
  sortant_matricule    String      @db.VarChar(50)
  entrant_nom          String      @db.VarChar(255)
  entrant_matricule    String      @db.VarChar(50)
  poste_nom            String      @db.VarChar(160)
  materiel             String?
  evenements           String?
  consignes            String?
  confirmation_sortant Boolean     @default(false)
  confirmation_entrant Boolean     @default(false)
  utilisateur_id       String      @db.Uuid
  site_id              String?     @db.Uuid
  vacation_id          String?     @db.Uuid
  site                 site?       @relation(fields: [site_id], references: [id], map: "fk_passation_site")
  utilisateur          Utilisateur @relation(fields: [utilisateur_id], references: [id], map: "fk_passation_utilisateur")
  vacation             Vacation?   @relation(fields: [vacation_id], references: [id], map: "fk_passation_vacation")

  @@index([site_id, cree_le], map: "idx_passation_site_date")
}

model ronde {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cree_le        DateTime    @default(now()) @db.Timestamp(6)
  nom_parcours   String      @db.VarChar(160)
  debut          DateTime    @default(now()) @db.Timestamp(6)
  fin            DateTime?   @db.Timestamp(6)
  points         Json        @default("[]")
  observations   String?
  site_id        String      @db.Uuid
  utilisateur_id String      @unique(map: "idx_ronde_agent_active", where: raw("(fin IS NULL)")) @db.Uuid
  site           site        @relation(fields: [site_id], references: [id], map: "fk_ronde_site")
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [id], map: "fk_ronde_utilisateur")

  @@index([site_id, debut], map: "idx_ronde_site_debut")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model signalement_logistique {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cree_le           DateTime    @default(now()) @db.Timestamp(6)
  date_operation    DateTime    @db.Date
  heure             DateTime    @db.Time(0)
  type_signalement  String      @db.VarChar(30)
  camion            String?     @db.VarChar(160)
  transporteur      String?     @db.VarChar(255)
  document          String?     @db.VarChar(160)
  casse             String?
  manquant          String?
  vides             String?
  phn               String?
  description_faits String?
  personne          String?     @db.VarChar(255)
  observations      String?
  mesures_prises    String?
  site_id           String      @db.Uuid
  utilisateur_id    String      @db.Uuid
  site              site        @relation(fields: [site_id], references: [id], map: "fk_signalement_logistique_site")
  utilisateur       Utilisateur @relation(fields: [utilisateur_id], references: [id], map: "fk_signalement_logistique_utilisateur")

  @@index([site_id, date_operation(sort: Desc), heure(sort: Desc)], map: "idx_signalement_logistique_site_date")
}

model site {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                    String                   @db.VarChar(255)
  adresse                String
  horaires_ouverture     String?                  @db.VarChar(255)
  type_site              TypeSite                 @default(USINE)
  actif                  Boolean                  @default(true)
  compte_rendu           CompteRendu[]
  controle_alcoolemie    controle_alcoolemie[]
  flux_logistique        flux_logistique[]
  passage_vehicule       PassageVehicule[]
  passation              passation[]
  poste                  Poste[]
  ronde                  ronde[]
  signalement_logistique signalement_logistique[]
  suivi_cle              suivi_cle[]
  utilisateur            Utilisateur[]
  vacation               Vacation[]
  visiteur               Visiteur[]
  zone                   Zone[]
}

model suivi_cle {
  id                                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cree_le                              DateTime    @default(now()) @db.Timestamp(6)
  date_suivi                           DateTime    @db.Date
  lieu                                 String      @db.VarChar(255)
  perception_matin                     DateTime?   @db.Time(0)
  responsable_perception_matin         String?     @db.VarChar(255)
  reintegration_matin                  DateTime?   @db.Time(0)
  responsable_reintegration_matin      String?     @db.VarChar(255)
  perception_apres_midi                DateTime?   @db.Time(0)
  responsable_perception_apres_midi    String?     @db.VarChar(255)
  reintegration_apres_midi             DateTime?   @db.Time(0)
  responsable_reintegration_apres_midi String?     @db.VarChar(255)
  observations                         String?
  site_id                              String      @db.Uuid
  utilisateur_id                       String      @db.Uuid
  site                                 site        @relation(fields: [site_id], references: [id], map: "fk_suivi_cle_site")
  utilisateur                          Utilisateur @relation(fields: [utilisateur_id], references: [id], map: "fk_suivi_cle_utilisateur")

  @@index([site_id, date_suivi], map: "idx_suivi_cle_site_date")
}

enum TypeSite {
  USINE
  AGENCE

  @@map("type_site")
}

enum ShiftAgent {
  JOUR
  NUIT

  @@map("shift_agent")
}
