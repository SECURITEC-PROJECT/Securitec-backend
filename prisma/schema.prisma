generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SiteType {
  USINE
  AGENCE

  @@map("site_type")
}

model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(255)
  type      SiteType
  address   String   @default("") @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  users     User[]
  posts     Post[]
  shifts    Shift[]
  minutes   Minutes[]
  logo      SiteLogo?

  @@map("site")
}

/// Compte de connexion (identifiant + PIN). Un administrateur (profile = 1) n'est rattaché à aucun site : il les voit tous.
model User {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String           @db.VarChar(255)
  identifier String           @unique @db.VarChar(100)
  /// Matricule propre à chaque utilisateur : sert aussi d'identifiant de connexion.
  matricule  String           @unique @db.VarChar(50)
  pinHash    String           @map("pin_hash") @db.VarChar(255)
  /// Profil de base du rôle (1 = administrateur, 2 = chef de poste, ...), recopié depuis le rôle.
  profile    Int
  active     Boolean          @default(true)
  siteId     String?          @map("site_id") @db.Uuid
  site       Site?            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  roleId     String           @map("role_id") @db.Uuid
  role       AccessRole       @relation(fields: [roleId], references: [id])
  overrides  UserPermission[]
  details    UserProfile?
  documents  UserDocument[]
  photo      UserPhoto?
  postAssignments PostUser[]
  reportsMade     SheetReport[] @relation("ReportAuthor")
  reportsResolved SheetReport[] @relation("ReportResolver")
  notifications   Notification[]
  shifts          Shift[]
  sheetRows  SheetRow[]
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([siteId])
  @@index([roleId])
  @@map("app_user")
}

/// Rôle : un ensemble de permissions « module.action » (voir src/permissions/catalog.js).
model AccessRole {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.Text
  baseProfile Int              @default(5) @map("base_profile")
  system      Boolean          @default(false)
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("access_role")
}

model RolePermission {
  roleId     String     @map("role_id") @db.Uuid
  permission String     @db.VarChar(100)
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permission")
}

/// Ajustement individuel : permission accordée ou retirée en plus du rôle.
model UserPermission {
  userId     String   @map("user_id") @db.Uuid
  permission String   @db.VarChar(100)
  granted    Boolean
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permission")
}

/// Fiche d'un utilisateur : prénom et coordonnées.
model UserProfile {
  userId     String   @id @map("user_id") @db.Uuid
  firstName  String?  @map("first_name") @db.VarChar(255)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(60)
  street     String?  @db.VarChar(255)
  street2    String?  @db.VarChar(255)
  postalCode String?  @map("postal_code") @db.VarChar(30)
  city       String?  @db.VarChar(160)
  country    String?  @db.VarChar(120)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

/// Poste de garde d'un site.
model Post {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  siteId    String   @map("site_id") @db.Uuid
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Utilisateurs affectés au poste (des comptes du même site) : seuls à voir les feuilles de saisie du poste.
  assignees PostUser[]
  shifts    Shift[]
  sheets    PostSheet[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([siteId, name])
  @@map("post")
}

/// Logo d'un site (image PNG, JPEG ou WebP de 1 Mo maximum).
model SiteLogo {
  siteId    String   @id @map("site_id") @db.Uuid
  mimeType  String   @map("mime_type") @db.VarChar(100)
  content   Bytes    @db.ByteA
  size      Int
  userId    String?  @map("user_id") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_logo")
}

/// Document joint à un compte (contrat, pièce d'identité, diplôme...).
model UserDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(240)
  extension String   @db.VarChar(12)
  mimeType  String   @map("mime_type") @db.VarChar(160)
  size      Int
  category  String   @default("Autre") @db.VarChar(80)
  content   Bytes    @db.ByteA
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_document")
}

enum ColumnType {
  TEXT
  NUMBER
  DATE
  TIME
  SELECT
  CHECKBOX
  /// Colonne qui déclenche une action (voir ColumnAction) au lieu de recevoir une valeur.
  ACTION

  @@map("column_type")
}

enum ColumnAction {
  /// Joindre des fichiers à la ligne.
  ATTACH_FILES

  @@map("column_action")
}

/// Feuille de saisie d'un poste : un « onglet » avec ses propres colonnes, que les utilisateurs remplissent.
model PostSheet {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(160)
  position  Int           @default(0)
  active    Boolean       @default(true)
  /// Droits propres à la feuille, appliqués en plus des permissions du rôle (le plus restrictif l'emporte).
  /// Tout false = lecture seule. Ex. une « Main courante » : ajout seul (pas de modification ni de suppression).
  allowCreate Boolean     @default(true) @map("allow_create")
  allowUpdate Boolean     @default(true) @map("allow_update")
  allowDelete Boolean     @default(false) @map("allow_delete")
  columns   SheetColumn[]
  rows      SheetRow[]
  reports   SheetReport[]
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([postId, name])
  @@map("post_sheet")
}

/// En-tête de colonne d'une feuille. L'identifiant de la colonne est la clé de sa valeur dans chaque ligne.
model SheetColumn {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sheetId  String     @map("sheet_id") @db.Uuid
  sheet    PostSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  label    String     @db.VarChar(120)
  type     ColumnType @default(TEXT)
  /// Renseigné quand le type est ACTION.
  action   ColumnAction?
  /// Action ATTACH_FILES : autorise l'envoi de fichiers depuis l'appareil.
  allowUpload Boolean @default(true) @map("allow_upload")
  /// Action ATTACH_FILES : autorise la prise de photo avec la caméra.
  allowPhoto  Boolean @default(false) @map("allow_photo")
  required Boolean    @default(false)
  /// Choix proposés pour une colonne de type SELECT (tableau de textes).
  options  Json       @default("[]")
  position Int        @default(0)

  @@index([sheetId])
  @@map("sheet_column")
}

/// Ligne saisie dans une feuille : valeurs indexées par identifiant de colonne, avec horodatage et auteur automatiques.
model SheetRow {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sheetId   String    @map("sheet_id") @db.Uuid
  sheet     PostSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  values    Json      @default("{}")
  createdBy String?   @map("created_by") @db.Uuid
  author    User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  files     SheetFile[]
  reports   SheetReport[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sheetId, createdAt])
  @@map("sheet_row")
}

/// Fichier joint à une ligne par une colonne de type ACTION / ATTACH_FILES. columnId n'a pas de clé étrangère : les fichiers survivent au retrait de la colonne.
model SheetFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rowId     String   @map("row_id") @db.Uuid
  row       SheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  columnId  String   @map("column_id") @db.Uuid
  name      String   @db.VarChar(240)
  extension String   @db.VarChar(12)
  mimeType  String   @map("mime_type") @db.VarChar(160)
  size      Int
  content   Bytes    @db.ByteA
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([rowId, columnId])
  @@map("sheet_file")
}

/// Affectation d'un utilisateur à un poste de garde (un poste a plusieurs utilisateurs, un utilisateur peut avoir plusieurs postes).
model PostUser {
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_user")
}

/// Photo d'identité d'un utilisateur (image PNG, JPEG ou WebP de 2 Mo maximum).
model UserPhoto {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  content   Bytes    @db.ByteA
  size      Int
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_photo")
}

/// Signalement d'un problème à un supérieur, depuis une feuille de saisie (éventuellement à propos d'une ligne).
/// Chaîne hiérarchique : Agent APS → Chef de poste → Responsable sécurité. Un signalement transmis garde un lien (parentId) vers l'original.
model SheetReport {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sheetId     String         @map("sheet_id") @db.Uuid
  sheet       PostSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  rowId       String?        @map("row_id") @db.Uuid
  row         SheetRow?      @relation(fields: [rowId], references: [id], onDelete: SetNull)
  postId      String         @map("post_id") @db.Uuid
  siteId      String         @map("site_id") @db.Uuid
  reporterId  String         @map("reporter_id") @db.Uuid
  reporter    User           @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  /// Profil de base de l'auteur et du destinataire (2 = chef de poste, 3 = responsable sécurité, 5 = agent APS).
  fromProfile Int            @map("from_profile")
  toProfile   Int            @map("to_profile")
  message     String         @db.Text
  parentId    String?        @map("parent_id") @db.Uuid
  parent      SheetReport?   @relation("ReportChain", fields: [parentId], references: [id], onDelete: SetNull)
  children    SheetReport[]  @relation("ReportChain")
  notifications Notification[]
  /// Renseignés quand un destinataire marque le signalement comme traité.
  resolvedAt  DateTime?      @map("resolved_at") @db.Timestamptz(6)
  resolvedById String?       @map("resolved_by") @db.Uuid
  resolver    User?          @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sheetId])
  @@index([parentId])
  @@map("sheet_report")
}

/// Notification destinée à un utilisateur (signalement reçu, transmis...).
model Notification {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String       @default("REPORT") @db.VarChar(40)
  title     String       @db.VarChar(200)
  body      String       @default("") @db.Text
  reportId  String?      @map("report_id") @db.Uuid
  report    SheetReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  readAt    DateTime?    @map("read_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// Vacation du planning : un utilisateur est en service sur un site (et éventuellement un poste) entre deux dates.
/// Un utilisateur ne peut pas avoir deux vacations qui se chevauchent ; changer de site = une vacation sur un autre site.
model Shift {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String   @map("site_id") @db.Uuid
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  postId    String?  @map("post_id") @db.Uuid
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(6)
  note      String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startsAt, endsAt])
  @@index([userId, startsAt])
  @@index([siteId])
  @@map("shift")
}

/// Compte rendu d'un site : une page libre dont la mise en page (blocs de texte et tableaux liés aux feuilles de saisie,
/// avec leur position, leur plage de dates et leurs colonnes ajoutées à la main) est enregistrée telle quelle dans `layout`.
model Minutes {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(160)
  layout    Json     @default("{}")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([siteId])
  @@map("minutes")
}
